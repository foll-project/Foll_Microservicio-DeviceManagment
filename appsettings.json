{
  "ConnectionStrings": { "DefaultConnection": "Host=localhost;Port=5432;Database=foll_devices;Username=foll;Password=" },
  "JwtSettings": { "Secret": "" },
  "InternalApi": { "ApiKey": "" },
  "Services": {
    "Care": { "BaseUrl": "http://localhost:5237", "TimeoutSeconds": 10 },
    "Notifications": { "BaseUrl": "http://localhost:5237", "TimeoutSeconds": 10 }
  },
  "Mqtt": {
    "Enabled": true, "Host": "localhost", "Port": 1883, "ClientId": "foll-devices-service-worker",
    "HeartbeatTopic": "foll/devices/+/heartbeat", "PowerTopic": "foll/devices/+/power", "UseTls": false
  },
  "DeviceMonitoring": {
    "Enabled": true, "LowBatteryThreshold": 15, "ExpectedHeartbeatIntervalSeconds": 10,
    "MissedHeartbeatsBeforeDisconnect": 3, "ConnectivityCheckIntervalSeconds": 5
  },
  "Outbox": { "Enabled": true, "PollIntervalSeconds": 2, "BatchSize": 20 },
  "Telemetry": { "Enabled": true, "Capacity": 1000, "MaxAgeSeconds": 30, "PollIntervalMilliseconds": 500 },
  "ApplyMigrationsOnStartup": false,
  "Swagger": { "Enabled": false },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*"
}
